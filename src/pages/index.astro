---
import PageLayout from '~/layouts/PageLayout.astro';
import Header from '~/components/common/Header.astro';
import { NAVIGATION } from '~/config';
import Logo from '~/assets/icons/logo.svg';
import heroVideo from '~/assets/videos/evene hero compressed.mp4';
import { Image } from 'astro:assets';
import calidadImg from '~/assets/images/landing/Calidad.png';
import personalizacionImg from '~/assets/images/landing/Personalizacion.png';
import excelenciaImg from '~/assets/images/landing/Excelencia.png';
import joseAvatar from '~/assets/images/landing/jose-garcia.png';
import anaAvatar from '~/assets/images/landing/ana-garcia.png';
import danielAvatar from '~/assets/images/landing/daniel-garcia.png';
import tagomagoImg from '~/assets/promociones/isla-tagomago/aerial-view-main-sunset.png';

const developments = [
  {
    name: 'ISLA TAGOMAGO',
    location: 'Dehesa de la Villa, Madrid',
    status: 'Licencia de obra concedida',
    description: '2 chalets pareados de lujo con jardín, piscina privada y azotea. Diseño contemporáneo, materiales premium y eficiencia energética A+.',
    image: tagomagoImg,
    href: '/promociones/isla-tagomago/',
    tags: ['Chalets', 'Piscina', 'Jardín', 'Ascensor privado'],
  },
];
---

<PageLayout
  metadata={{
    title: 'Evene',
    description: 'Evene - Definiendo los estándares del desarrollo inmobiliario',
  }}
>
  <Header slot="header" {...NAVIGATION().header} isFloatingAtTop isSticky />
  <!-- Hero Section -->
  <section class="relative w-full h-screen overflow-hidden flex items-center justify-center">
    <!-- Video Background -->
    <video
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 min-w-full min-h-full w-auto h-full object-cover -z-20"
      autoplay
      muted
      loop
      playsinline
    >
      <source src={heroVideo} type="video/mp4" />
    </video>

    <!-- Dark Overlay -->
    <div class="absolute inset-0 bg-linear-to-b from-black/50 via-black/60 to-black/70 -z-10"></div>

    <!-- Centered Content -->
    <div class="flex flex-col items-center justify-center text-center p-8 z-10 animate-fade-in-up">
      <Logo class="w-[min(500px,80vw)] h-auto brightness-0 invert mb-8" />
      <p class="text-lg md:text-xl text-white/90 font-light tracking-[0.15em] uppercase max-w-[600px] leading-relaxed">
        Definiendo los estándares de la promoción inmobiliaria
      </p>
    </div>
  </section>

  <!-- Company Overview Section -->
  <section id="about" class="bg-[#faf9f7] py-20 md:py-28 px-6">
    <div class="max-w-5xl mx-auto">
      <!-- Section Title -->
      <h2
        class="scroll-animate text-center text-sm md:text-base tracking-[0.3em] uppercase text-[#1a1a1a] mb-16 font-medium"
      >
        Sobre Nosotros
      </h2>

      <!-- Stats Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-8 mb-16 md:mb-20">
        <!-- Stat 1: Homes -->
        <div class="scroll-animate text-center" data-delay="100">
          <p class="font-serif text-6xl md:text-7xl lg:text-8xl text-[#1a1a1a] mb-4 tracking-tight">
            1000<span class="text-[#8b4513]">+</span>
          </p>
          <p class="text-sm md:text-base tracking-[0.15em] uppercase text-[#4a4a4a] max-w-xs mx-auto leading-relaxed">
            Viviendas Construidas y Vendidas por Nuestros Socios
          </p>
        </div>

        <!-- Stat 2: Year Founded -->
        <div class="scroll-animate text-center" data-delay="200">
          <p class="font-serif text-6xl md:text-7xl lg:text-8xl text-[#1a1a1a] mb-4 tracking-tight">2022</p>
          <p class="text-sm md:text-base tracking-[0.15em] uppercase text-[#4a4a4a] max-w-xs mx-auto leading-relaxed">
            Año de Fundación
          </p>
        </div>
      </div>

      <!-- Divider -->
      <div class="scroll-animate w-16 h-px bg-[#8b4513]/40 mx-auto mb-16 md:mb-20" data-delay="300"></div>

      <!-- Description Paragraphs -->
      <div class="max-w-3xl mx-auto space-y-8 text-center">
        <p class="scroll-animate text-base md:text-lg text-[#2a2a2a] leading-relaxed" data-delay="100">
          <span class="text-[#8b4513] font-medium">Evene</span> es una promotora inmobiliaria de servicio integral impulsada
          por un equipo familiar de profesionales con una dilatada trayectoria en el sector. Nuestra experiencia combinada
          abarca todas las áreas del desarrollo inmobiliario, desde la adquisición del suelo hasta la entrega de llaves.
        </p>
        <p class="scroll-animate text-base md:text-lg text-[#2a2a2a] leading-relaxed" data-delay="200">
          Una comunicación clara y una ejecución impecable nos permiten desarrollar, comercializar y gestionar proyectos
          residenciales de la más alta calidad en Madrid.
        </p>
        <p class="scroll-animate text-[#5a4a3a] text-base md:text-lg leading-relaxed italic" data-delay="300">
          Nuestra historia de éxito incluye la construcción y venta de más de mil viviendas en Madrid, experiencia que
          ahora canalizamos a través de Evene para redefinir los estándares de la promoción inmobiliaria en la capital y
          otras ubicaciones estratégicas de España.
        </p>
      </div>

      <!-- Divider -->
      <div class="scroll-animate w-16 h-px bg-[#8b4513]/40 mx-auto mt-16 md:mt-20 mb-12 md:mb-16" data-delay="400">
      </div>

      <!-- Founders Section -->
      <h3
        class="scroll-animate text-center font-serif text-xl md:text-2xl lg:text-3xl tracking-[0.08em] text-[#1a1a1a] mb-14 md:mb-20"
      >
        Nuestro Equipo Fundador
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-14 max-w-5xl mx-auto">
        <!-- Founder 1: José García -->
        <div class="scroll-animate founder-card group" data-direction="left">
          <div class="flex flex-col items-center text-center">
            <!-- Avatar Placeholder -->
            <div class="relative mb-6">
              <div
                class="w-36 h-36 md:w-40 md:h-40 rounded-full bg-[#e8e4df] border-2 border-[#8b4513]/20 overflow-hidden transition-all duration-500 group-hover:border-[#8b4513]/50 group-hover:shadow-lg group-hover:shadow-[#8b4513]/10"
              >
                <!-- Replace this div with: <img src="/path/to/jose-avatar.jpg" alt="José García" class="w-full h-full object-cover" /> -->
                <Image src={joseAvatar} alt="José García" class="w-full h-full object-cover" />
              </div>
              <div
                class="absolute -bottom-1 -right-1 w-8 h-8 rounded-full bg-[#8b4513] flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500"
              >
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </div>
            </div>
            <!-- Name & Title -->
            <h4 class="font-serif text-xl md:text-2xl text-[#1a1a1a] mb-1 tracking-wide">José García</h4>
            <p class="text-xs tracking-[0.25em] uppercase text-[#8b4513] font-medium mb-4">
              Administración y Dirección de Empresas &middot; MBA por IE Business School
            </p>
            <!-- Decorative line -->
            <div
              class="w-8 h-px bg-[#8b4513]/40 mx-auto mb-4 transition-all duration-500 group-hover:w-12 group-hover:bg-[#8b4513]/70"
            >
            </div>
            <!-- Description -->
            <p class="text-sm md:text-base text-[#4a4a4a] leading-relaxed">
              Director Adjunto de CLEMENT, S.A. y Consejero de ARRIENDA Rental Properties SOCIMI, S.A., lleva más de dos
              décadas trabajando en una de las promotoras de inmuebles con más proyección de Madrid así como en SOCIMI
              de nueva creación, desarrollando su actividad profesional en ambas sociedades en diferentes áreas, como
              marketing, finanzas y fiscalidad, lo que le otorga una visión estratégica que impulsa cada proyecto de
              EVENE.
            </p>
          </div>
        </div>

        <!-- Founder 2: Ana García -->
        <div class="scroll-animate founder-card group" data-delay="150">
          <div class="flex flex-col items-center text-center">
            <!-- Avatar Placeholder -->
            <div class="relative mb-6">
              <div
                class="w-36 h-36 md:w-40 md:h-40 rounded-full bg-[#e8e4df] border-2 border-[#8b4513]/20 overflow-hidden transition-all duration-500 group-hover:border-[#8b4513]/50 group-hover:shadow-lg group-hover:shadow-[#8b4513]/10"
              >
                <Image src={anaAvatar} alt="Ana García" class="w-full h-full object-cover" />
              </div>
              <div
                class="absolute -bottom-1 -right-1 w-8 h-8 rounded-full bg-[#8b4513] flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500"
              >
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </div>
            </div>
            <!-- Name & Title -->
            <h4 class="font-serif text-xl md:text-2xl text-[#1a1a1a] mb-1 tracking-wide">Ana García</h4>
            <p class="text-xs tracking-[0.25em] uppercase text-[#8b4513] font-medium mb-4">
              Abogada &middot; Diseño &amp; Urbanismo
            </p>
            <!-- Decorative line -->
            <div
              class="w-8 h-px bg-[#8b4513]/40 mx-auto mb-4 transition-all duration-500 group-hover:w-12 group-hover:bg-[#8b4513]/70"
            >
            </div>
            <!-- Description -->
            <p class="text-sm md:text-base text-[#4a4a4a] leading-relaxed">
              Jurista con amplia experiencia en derecho urbanístico y nuevas promociones inmobiliarias. Su pasión por el
              diseño de interiores aporta una sensibilidad estética única que eleva cada espacio que Evene concibe.
            </p>
          </div>
        </div>

        <!-- Founder 3: Daniel García -->
        <div class="scroll-animate founder-card group" data-direction="right" data-delay="300">
          <div class="flex flex-col items-center text-center">
            <!-- Avatar Placeholder -->
            <div class="relative mb-6">
              <div
                class="w-36 h-36 md:w-40 md:h-40 rounded-full bg-[#e8e4df] border-2 border-[#8b4513]/20 overflow-hidden transition-all duration-500 group-hover:border-[#8b4513]/50 group-hover:shadow-lg group-hover:shadow-[#8b4513]/10"
              >
                <Image src={danielAvatar} alt="Daniel García" class="w-full h-full object-cover" />
              </div>
              <div
                class="absolute -bottom-1 -right-1 w-8 h-8 rounded-full bg-[#8b4513] flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500"
              >
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </div>
            </div>
            <!-- Name & Title -->
            <h4 class="font-serif text-xl md:text-2xl text-[#1a1a1a] mb-1 tracking-wide">Daniel García</h4>
            <p class="text-xs tracking-[0.25em] uppercase text-[#8b4513] font-medium mb-4">
              Ing. Industrial &middot; Instalaciones
            </p>
            <!-- Decorative line -->
            <div
              class="w-8 h-px bg-[#8b4513]/40 mx-auto mb-4 transition-all duration-500 group-hover:w-12 group-hover:bg-[#8b4513]/70"
            >
            </div>
            <!-- Description -->
            <p class="text-sm md:text-base text-[#4a4a4a] leading-relaxed">
              Ingeniero industrial con dilatada experiencia en diseño eléctrico, telecomunicaciones, climatización y
              sistemas de seguridad. Su dominio técnico garantiza que cada promoción de Evene alcance los más altos
              estándares de eficiencia y confort.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Three Pillars Section -->
  <section class="bg-[#f5f4f2] py-20 md:py-32 px-6" id="pillars">
    <div class="max-w-7xl mx-auto">
      <!-- Section Title -->
      <h2
        class="scroll-animate text-center font-serif text-2xl md:text-3xl lg:text-4xl tracking-[0.08em] uppercase text-[#1a1a1a] mb-4"
      >
        Los Tres Pilares
      </h2>
      <p
        class="scroll-animate text-center font-serif text-lg md:text-xl lg:text-2xl tracking-[0.06em] uppercase text-[#1a1a1a]/80 mb-16 md:mb-24"
        data-delay="100"
      >
        de la Filosofía de Evene
      </p>

      <!-- Pillars Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-8">
        <!-- Pillar 1: Calidad -->
        <article class="scroll-animate pillar-card group" data-direction="left">
          <div class="relative overflow-hidden mb-8 aspect-4/3 bg-[#e8e6e3]">
            <Image
              src={calidadImg}
              alt="Calidad - Interiores de lujo y acabados premium"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div
              class="absolute inset-0 bg-linear-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            >
            </div>
          </div>
          <h3
            class="scroll-animate font-serif text-3xl md:text-4xl text-[#1a1a1a] mb-6 tracking-wide italic"
            data-delay="100"
          >
            Calidad
          </h3>
          <p class="scroll-animate text-[#4a4a4a] text-base leading-relaxed" data-delay="200">
            Evene desarrolla proyectos inmobiliarios para quienes valoran el diseño impecable, la artesanía superior y
            los acabados más exclusivos. Cada una de nuestras promociones encarna la verdadera definición de calidad,
            desde los materiales personalizados y las distribuciones cuidadosamente pensadas hasta las prestaciones
            elevadas de cada espacio.
          </p>
        </article>

        <!-- Pillar 2: Personalización -->
        <article class="scroll-animate pillar-card group" data-delay="100">
          <div class="relative overflow-hidden mb-8 aspect-4/3 bg-[#e8e6e3]">
            <Image
              src={personalizacionImg}
              alt="Personalización - Diseño a medida y planos flexibles"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div
              class="absolute inset-0 bg-linear-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            >
            </div>
          </div>
          <h3
            class="scroll-animate font-serif text-3xl md:text-4xl text-[#1a1a1a] mb-6 tracking-wide italic"
            data-delay="200"
          >
            Personalización
          </h3>
          <p class="scroll-animate text-[#4a4a4a] text-base leading-relaxed" data-delay="300">
            El verdadero lujo es cuestión de elección. Evene ofrece una propuesta de valor única que permite a los
            compradores seleccionar entre una sofisticada gama de acabados, diseños y distribuciones para adaptar su
            hogar a sus gustos individuales. La personalización va más allá de lo tangible: incluye vistas, planos
            flexibles y servicios exclusivos.
          </p>
        </article>

        <!-- Pillar 3: Excelencia -->
        <article class="scroll-animate pillar-card group" data-direction="right" data-delay="200">
          <div class="relative overflow-hidden mb-8 aspect-4/3 bg-[#e8e6e3]">
            <Image
              src={excelenciaImg}
              alt="Excelencia - Colaboración con profesionales de renombre"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div
              class="absolute inset-0 bg-linear-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            >
            </div>
          </div>
          <h3
            class="scroll-animate font-serif text-3xl md:text-4xl text-[#1a1a1a] mb-6 tracking-wide italic"
            data-delay="300"
          >
            Excelencia
          </h3>
          <p class="scroll-animate text-[#4a4a4a] text-base leading-relaxed" data-delay="400">
            La excelencia nace de nuestro compromiso con profesionales de primer nivel. Colaboramos con arquitectos de
            renombre, diseñadores de interiores, consultores y operadores de servicios. Nuestro equipo interno supervisa
            cada aspecto, desde la concepción hasta la finalización, dedicando el tiempo, la energía y los recursos
            necesarios para entregar productos y servicios excepcionales.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Promociones Section -->
  <section id="promociones" class="bg-[#faf9f7] py-24 md:py-32 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16 md:mb-20">
        <h2 class="scroll-animate text-sm md:text-base tracking-[0.3em] uppercase text-[#1a1a1a] mb-4 font-medium">
          Nuestras Promociones
        </h2>
        <p class="scroll-animate font-serif text-lg md:text-xl text-[#4a4a4a] max-w-2xl mx-auto leading-relaxed mb-6" data-delay="100">
          Proyectos residenciales exclusivos en ubicaciones privilegiadas de Madrid, donde la calidad, el diseño y la sostenibilidad definen cada hogar.
        </p>
        <div class="scroll-animate w-12 h-px bg-[#8b4513] mx-auto" data-delay="200"></div>
      </div>

      <!-- Development Cards -->
      {developments.map((dev) => (
        <a href={dev.href} class="group block">
          <article class="grid grid-cols-1 lg:grid-cols-2 gap-0 bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-shadow duration-500">
            <!-- Image -->
            <div class="relative overflow-hidden h-[300px] lg:h-[480px]">
              <Image
                src={dev.image}
                alt={`Vista de ${dev.name}`}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                loading="lazy"
                widths={[600, 900, 1200]}
              />
              <div class="absolute inset-0 bg-linear-to-t from-black/40 via-transparent to-transparent"></div>
              <!-- Status badge -->
              <div class="absolute top-5 left-5">
                <span class="inline-flex items-center gap-2.5 bg-white/97 backdrop-blur-sm text-[#1a1a1a] text-sm font-semibold tracking-wider uppercase px-5 py-3 rounded-full shadow-lg">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                  {dev.status}
                </span>
              </div>
            </div>

            <!-- Content -->
            <div class="flex flex-col justify-center p-8 md:p-12 lg:p-16">
              <p class="text-xs tracking-[0.25em] uppercase text-[#8b4513] mb-3 font-medium">
                {dev.location}
              </p>
              <h3 class="font-serif text-3xl md:text-4xl text-[#1a1a1a] mb-6 group-hover:text-[#8b4513] transition-colors">
                {dev.name}
              </h3>
              <div class="w-10 h-px bg-[#8b4513]/40 mb-6"></div>
              <p class="text-[#4a4a4a] leading-relaxed mb-8">
                {dev.description}
              </p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-2 mb-8">
                {dev.tags.map((tag) => (
                  <span class="px-3 py-1.5 bg-[#faf9f7] rounded-full text-xs tracking-wider uppercase text-[#1a1a1a] border border-[#8b4513]/20">
                    {tag}
                  </span>
                ))}
              </div>

              <!-- CTA -->
              <div class="inline-flex items-center gap-2 text-[#1a1a1a] font-medium group-hover:text-[#8b4513] transition-colors">
                Descubrir proyecto
                <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </div>
            </div>
          </article>
        </a>
      ))}
    </div>
  </section>

  <!-- Coming Soon -->
  <section class="bg-white py-24 md:py-32 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="scroll-animate text-sm md:text-base tracking-[0.3em] uppercase text-[#1a1a1a] mb-6 font-medium">
        Próximamente
      </h2>
      <div class="scroll-animate w-12 h-px bg-[#8b4513] mx-auto mb-10" data-delay="100"></div>
      <p class="scroll-animate font-serif text-2xl md:text-3xl text-[#1a1a1a] mb-6 leading-snug" data-delay="200">
        Nuevos proyectos en preparación
      </p>
      <p class="scroll-animate text-[#4a4a4a] leading-relaxed mb-10 max-w-2xl mx-auto" data-delay="300">
        Estamos trabajando en nuevas promociones en ubicaciones estratégicas de Madrid. Si quieres ser el primero en conocer nuestros próximos lanzamientos, no dudes en ponerte en contacto con nosotros.
      </p>
      <a
        href="/contact"
        class="bg-[#8b4513] hover:bg-[#8b4513]/90 text-white font-medium text-base px-10 py-4 rounded-full inline-flex items-center gap-2 transition-all shadow-md hover:shadow-lg hover:scale-105"
      >
        Contactar
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </section>
</PageLayout>
<style>
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fade-in-up 1.2s ease-out;
  }

  /* Scroll Animation Styles */
  .scroll-animate {
    opacity: 0;
    transition:
      opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .scroll-animate:not([data-direction]) {
    transform: translateY(40px);
  }

  .scroll-animate[data-direction='left'] {
    transform: translateX(-40px);
  }

  .scroll-animate[data-direction='right'] {
    transform: translateX(40px);
  }

  .scroll-animate[data-direction='up'] {
    transform: translateY(-40px);
  }

  .scroll-animate.animate-in {
    opacity: 1;
    transform: translate(0, 0);
  }

  /* Staggered animation delays */
  .scroll-animate[data-delay='100'].animate-in {
    transition-delay: 0.1s;
  }

  .scroll-animate[data-delay='200'].animate-in {
    transition-delay: 0.2s;
  }

  .scroll-animate[data-delay='300'].animate-in {
    transition-delay: 0.3s;
  }

  .scroll-animate[data-delay='400'].animate-in {
    transition-delay: 0.4s;
  }

  .scroll-animate[data-delay='500'].animate-in {
    transition-delay: 0.5s;
  }

  /* Founder Card Styles */
  .founder-card {
    padding: 2rem 1.5rem;
    border-radius: 0.5rem;
    transition:
      background-color 0.5s ease,
      box-shadow 0.5s ease;
  }

  .founder-card:hover {
    background-color: rgba(255, 255, 255, 0.7);
    box-shadow: 0 8px 40px rgba(139, 69, 19, 0.06);
  }
</style>

<script>
  // Scroll Animation Observer
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px',
  };

  const animateOnScroll = (entries: IntersectionObserverEntry[], observer: IntersectionObserver) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('animate-in');
        // Optional: unobserve after animation to improve performance
        observer.unobserve(entry.target);
      }
    });
  };

  const observer = new IntersectionObserver(animateOnScroll, observerOptions);

  // Observe all elements with scroll-animate class
  document.addEventListener('DOMContentLoaded', () => {
    const animatedElements = document.querySelectorAll('.scroll-animate');
    animatedElements.forEach((el) => observer.observe(el));
  });

  // Re-observe on page navigation (for SPAs)
  document.addEventListener('astro:page-load', () => {
    const animatedElements = document.querySelectorAll('.scroll-animate');
    animatedElements.forEach((el) => observer.observe(el));
  });
</script>
