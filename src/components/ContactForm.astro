---
interface Props {
  audienceName?: string;
  audienceType?: 'contact_form' | 'waitlist' | 'newsletter';
  successMessage?: string;
  errorMessage?: string;
}

const {
  audienceName = 'evene_contact',
  audienceType = 'contact_form',
  successMessage = 'Gracias por tu mensaje! Nos pondremos en contacto contigo lo antes posible.',
  errorMessage = 'Ha ocurrido un error al enviar el mensaje. Por favor, inténtalo de nuevo.',
} = Astro.props;
---

<div class="bg-white rounded-lg shadow-lg p-8">
  <form id="contact-form" class="space-y-6" data-audience-name={audienceName} data-audience-type={audienceType}>
    <div>
      <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Nombre</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        placeholder="Tu nombre"
      />
    </div>

    <div>
      <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Correo electrónico</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        placeholder="tu@correo.com"
      />
    </div>

    <div>
      <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Mensaje</label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        placeholder="¿En qué podemos ayudarte?"></textarea>
    </div>

    <div>
      <button type="submit" class="cta-gradient w-full">Enviar mensaje</button>
    </div>

    <p id="error-message" class="text-red-600 text-center hidden">
      {errorMessage}
    </p>
  </form>

  <div id="success-panel" class="hidden flex-col items-center justify-center text-center py-12 space-y-4">
    <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center">
      <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
    </div>
    <p class="text-green-700 text-lg font-medium">{successMessage}</p>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successPanel = document.getElementById('success-panel');
    const errorMessage = document.getElementById('error-message');

    if (form && successPanel && errorMessage) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const data = {
          audience: {
            name: form.dataset.audienceName,
            audience_type: form.dataset.audienceType,
          },
          email: formData.get('email'),
          first_name: formData.get('name'),
          message: formData.get('message'),
        };

        try {
          const response = await fetch('https://formrelay.hlab.es/api/subscribers/', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(data),
          });

          if (response.ok) {
            form.classList.add('hidden');
            successPanel.classList.remove('hidden');
            successPanel.classList.add('flex');
          } else {
            errorMessage.classList.remove('hidden');

            const errorText = await response.text().catch(() => 'No response text');
            console.error('Error submitting form:', {
              status: response.status,
              statusText: response.statusText,
              responseText: errorText,
            });
          }
        } catch (error) {
          errorMessage.classList.remove('hidden');
          console.error('Error submitting form:', error);
        }
      });
    }
  });
</script>

